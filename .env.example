# Copy to .env for local dev (start.sh + app/main.py load it).
# .env is gitignored. In prod use: fly secrets set KEY=value

# Session cookie signing key — MUST be stable or logins die on every restart.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Initial admin password, used only when no admin exists yet (default: admin).
# ADMIN_PASSWORD=

# Local DB path (default: ./bp.db)
# BP_DB=bp.db
